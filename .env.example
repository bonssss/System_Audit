# Database Configuration (PostgreSQL for production, SQLite for dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/system_audit?schema=public"
# DATABASE_URL="file:./dev.db"

# Server & Auth
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="your-256-bit-secret-jwt-key"

# AI Provider Configuration
OPENAI_API_KEY="sk-..."
AI_PROVIDER="local" # 'local' | 'openai' | 'anthropic' | 'gemini'
AI_MODEL="gpt-4o"

# Storage
STORAGE_DRIVER="local" # 'local' | 's3'
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="ai-project-scanner-reports"

# Redis Queue (BullMQ)
REDIS_URL="redis://localhost:6379"
